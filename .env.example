# ============================================
# NC-MINEMAN ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in values
# ============================================

# ============================================
# APPLICATION URLS
# Change to your domain for production
# ============================================
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# AUTHENTICATION SECRETS
# Generate with: openssl rand -hex 32
# REQUIRED - Application will not start without these
# ============================================
JWT_SECRET="generate-a-64-char-random-string-here"
NEXTAUTH_SECRET="generate-another-64-char-random-string-here"

# ============================================
# DISCORD OAUTH AUTHENTICATION
# Get credentials from: https://discord.com/developers/applications
# REQUIRED - Application will not start without these
# ============================================
DISCORD_CLIENT_ID="client_xxx"
DISCORD_CLIENT_SECRET="secret_xxx"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# ============================================
# DISCORD BOT & GUILD CONFIGURATION
# Bot token from Discord developer portal (Bot section)
# Guild ID from Discord (enable Developer Mode, right-click guild)
# Guild name displayed on login error pages
# Invite URL for non-members to join the guild
# Role map format: discord_role_id:site_role:direction (direction optional, default discord-to-site)
#   - discord_role_id: The Discord role's ID (from Discord developer portal)
#   - site_role: The corresponding site role name (e.g., admin, god, helper)
#   - direction: "discord-to-site", "site-to-discord", or "both" (optional, default discord-to-site)
#   Example: "123456789:admin:both,987654321:helper,111222333:god"
# ============================================
DISCORD_BOT_TOKEN="Bot YOUR_BOT_TOKEN_HERE"
DISCORD_GUILD_ID="YOUR_GUILD_ID"
DISCORD_GUILD_NAME="Elsahideout"
DISCORD_INVITE_URL="https://discord.gg/YOUR_INVITE_CODE"
DISCORD_TO_SITE_ROLE_MAP=""

# ============================================
# ADMIN CONFIGURATION
# Email address(es) or Discord usernames that get admin privileges
# For multiple admins, use comma-separated list
# REQUIRED - Application will not start without this
# ============================================
ADMIN_USERNAMES="admin1,admin2"

# ============================================
# SPACETIMEDB DATABASE
# Embedded database for server management
# ============================================
SPACETIMEDB_ENABLED="true"
SPACETIMEDB_PORT="3001"
SPACETIMEDB_HOST="127.0.0.1"

# ============================================
# SERVER CONFIGURATION (Optional)
# ============================================
HOST="0.0.0.0"
PORT="3000"

# ============================================
# VELOCITY PROXY FORWARDING
# Required only if using Velocity proxy
# ============================================
# VELOCITY_SECRET="your-velocity-secret-here"
# FORCE_VELOCITY_AUTOCONFIG="false"

# ============================================
# OPTIONAL: FRP BINARY PATH OVERRIDE
# ============================================
# FRPC_PATH="/path/to/frpc"

# ============================================
# OPTIONAL: HMR DISABLE
# Set to true to disable hot module replacement
# ============================================
# DISABLE_HMR="false"

# ============================================
# OPTIONAL: AI FEATURES
# ============================================
# GEMINI_API_KEY="your-gemini-api-key"

# ============================================
# OPTIONAL: EXTERNAL DATABASE
# ============================================
# DATABASE_URL="postgresql://user:password@localhost:5432/minemanager"
# REDIS_URL="redis://localhost:6379"

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ============================================
# SITE CONFIGURATION
# Optional - defaults are in lib/site.config.ts
# ============================================
SITE_NAME_SHORT="Hideout"
SITE_NAME_FULL="Hideout SMP"
SITE_DOMAIN="hideoutsmp.com"
SERVER_IP="play.hideoutsmp.com"
YOUTUBE_URL="https://youtube.com/@YourChannel"
DISCORD_URL="https://discord.gg/your-invite"
SUPPORT_EMAIL="support@your-domain.com"
COOKIE_NAME="app_session"
THEME_KEY="app-theme"

# ============================================
# POLAR.SH PAYMENT CONFIGURATION
# Get your access token from https://polar.sh
# ============================================
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="sandbox"
