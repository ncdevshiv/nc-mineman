# MineServer2 Environment Variables

# Application URL
# The URL where this application is hosted
APP_URL="http://localhost:3000"

# NextAuth.js Configuration
# Secret key for signing tokens (generate a strong random string)
NEXTAUTH_SECRET="your-secret-key-here"

# NextAuth.js URL
# Should match your APP_URL
NEXTAUTH_URL="http://localhost:3000"

# Optional: AI Features
# If you want to use AI-powered features like chat or automation
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Database Configuration (if using external database)
# DATABASE_URL="postgresql://user:password@localhost:5432/minemanager"

# Optional: Redis Configuration (if using Redis for caching)
# REDIS_URL="redis://localhost:6379"

# Optional: Email Configuration (if using email notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Server Management Configuration
# JAVA_PATH="java"  # Path to Java executable
# DEFAULT_MEMORY="2G"  # Default memory allocation for servers
